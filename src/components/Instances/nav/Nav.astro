<!-- Nav.astro -->
---
import styles from './Nav.module.css';
import typo from "../../../styles/typography.module.css";

import iconLight from "../../../assets/iconLight.svg?url";

import gamesIcon from "./assets/gameMenuIcon.svg";
import socialIcon from "./assets/socialIcon.svg";
import exploreIcon from "./assets/exploreIcon.svg";
import extraIcon from "./assets/extraIcon.svg";
---

<section class={styles.container}>
    <img class={styles.logoIcon} src={iconLight} />

    <div class={styles.menuItem}>
        <input id="games" type="radio" name="menu" checked/>
        <div class={styles.backgroundColour}></div>
        <label for="games" style={`--gamesIconUrl: url(${gamesIcon.src})`}></label>
    </div>
    <div class={styles.menuItem}>
        <input id="explore" type="radio" name="menu" />
        <div class={styles.backgroundColour}></div>
        <label for="explore" style={`--gamesIconUrl: url(${exploreIcon.src})`}></label>
    </div>
    <div class={styles.menuItem}>
        <input id="social" type="radio" name="menu" />
        <div class={styles.backgroundColour}></div>
        <label for="social" style={`--gamesIconUrl: url(${socialIcon.src})`}></label>
    </div>
    <div class={styles.menuItem}>
        <input id="extra" type="radio" name="menu" />
        <div class={styles.backgroundColour}></div>
        <label for="extra" style={`--gamesIconUrl: url(${extraIcon.src})`}></label>
    </div>
</section>