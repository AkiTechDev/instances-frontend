---
const { id = "gradient-default", gradientStart = "#c589f4", gradientEnd = "#532b56", rotation = 0, width = 261, height = 261 } = Astro.props;
---

<svg
  width={width}
  height={height}
  viewBox="0 0 261 261"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  style={`transform: rotate(${rotation}deg)`}
  >
    <defs>
        <linearGradient
            id={id}
            x1=".5"
            y1="260"
            x2="204.5"
            y2="80"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color={gradientStart}></stop><stop
                offset="1"
                stop-color={gradientEnd}
                stop-opacity=".5"></stop></linearGradient
            >
    </defs>
    <path
        d="M130.249 86.473c-24.104 0-43.776 19.672-43.776 43.776v43.777h43.776c24.105 0 43.777-19.673 43.777-43.777s-19.672-43.776-43.777-43.776m0-86.473c71.989 0 130.25 58.369 130.25 130.249s-58.261 130.249-130.25 130.249H0V130.249C0 58.369 58.261 0 130.249 0"
        fill={`url(#${id})`}>
    </path>
</svg>
