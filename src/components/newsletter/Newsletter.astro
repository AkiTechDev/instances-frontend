<!-- NewsletterSection.astro -->
---
import styles from './newsletter.module.css';
import button from "../../styles/components/button.module.css";

import CoffeePNG from '../../assets/images/coffee.png';
import { Picture } from 'astro:assets';

---
<section class={styles.section}>
    <Picture src={CoffeePNG} formats={['avif', 'webp']} alt="Unrelated graphic of a take-away coffee cup" />
    <div class={styles.card}>
        <div class={styles.cardContent}>
            <h4 class="h4">Stay in the Loop</h4>
            <p class="subTitle">Be the first to know about new games, platform updates, and special offers.</p>
        </div>
        <form class={styles.form} id="newsletterForm">
            <input type="email" id="email" name="email" placeholder="Enter Your email" />
            <button class:list={[button.btn, button.vibrant]}><p class="buttonText">Submit</p></button>
        </form>
    </div>
</section>

<script>
    import { emailautocomplete } from './email_autocomplete';
    document.addEventListener("DOMContentLoaded", function() {
        emailautocomplete("#email");
    });
</script>

<style is:global >
    .emailAutocomplete {
        color: var(--color-text-dark);
        opacity: 0.8;
    }
</style>