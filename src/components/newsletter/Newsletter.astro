<!-- NewsletterSection.astro -->
---
import styles from './newsletter.module.css';
import search from "../../styles/components/search.module.css";
import ArrowIcon from "../../assets/icons/arrow.svg";
import LogoIcon from "../../assets/icons/logos/icon.svg";
---
<section class={styles.container}>
    <div class={styles.card}>
        <LogoIcon width={660} height={660} style={"--path1: #85B6FF; --path2: #253D4E;"} />
        <div class={styles.content}>
            <h4 class="h4">Stay in the Loop</h4>
            <p class="subTitle">Be the first to know about new games, platform updates, and special offers.</p>
        </div>
        <label class={`${search.label} ${search.withFilterBtn}`}>
            <input id="email" type="email" name="email" placeholder="Enter your email" />
            <button class={styles.submitBtn} style={`--icon: url("${ArrowIcon.src}")`}></button>
        </label>
    </div>
</section>

<script>
    import { emailautocomplete } from './email_autocomplete';
    document.addEventListener("DOMContentLoaded", function() {
        emailautocomplete("#email");
    });
</script>

<style is:global >
    .emailAutocomplete {
        color: var(--color-text-dark);
        opacity: 0.7;
    }
</style>