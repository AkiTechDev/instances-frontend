---
import styles from "./Header.module.css";
import LogoIcon from "../../../assets/icons/logos/icon.svg";

import button from "../../../styles/components/button.module.css";
---

<header class={styles.header}>
    <a href="/" target="_self" class={styles.logo}>
        <LogoIcon style={"--path2: var(--c-white);"} width="50" height="50" />
        <span>instances</span>
    </a>

    <nav>
        <a class="bodyText" href="#services">Why Us</a>
        <a class="bodyText" href="#games">Games</a>
        <a class="bodyText" href="#process">Creating an Instance</a>
        <a class="bodyText" href="#faqs">FAQs</a>
        <!--<a class="bodyText" href="#privacy-policy">Privacy Policy</a> -->
    </nav>
    <div class={styles.actions}>
        <button id="loginBtn" data-login class={`${button.btn} ${button.outlineLight} ${button.sm}`}>
            <p class="buttonText">Log in</p>
        </button>
        <button id="signupBtn" data-login class={`${button.btn} ${button.vibrant} ${button.sm} ${button.icon}`} style={`--icon: url(${LogoIcon.src});`}>
            <p class="buttonText">Start playing</p>
        </button>
        <a href="/dashboard" id="dashboardBtn" class={`${button.btn} ${button.vibrant} ${button.sm}`} style="display: none; text-decoration: none;">
            <p class="buttonText">Go to Dashboard</p>
        </a>
    </div>
</header>

<script>
    import { hasSession } from "../../../lib/auth";

    if (await hasSession()) {
        document.getElementById("loginBtn")?.remove();
        document.getElementById("signupBtn")?.remove();

        const dashboardBtn = document.getElementById("dashboardBtn");
        if (dashboardBtn) {
            dashboardBtn.style.display = "";
        }
    }
</script>