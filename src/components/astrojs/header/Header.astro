---
import styles from "./Header.module.css";
import LogoIcon from "../../../assets/icons/logos/icon.svg";

import button from "../../../styles/components/button.module.css";
---

<header class={styles.header}>
    <a href="/" target="_self" class={styles.logo}>
        <LogoIcon style={"--path2: var(--c-white);"} width="50" height="50" />
        <span>instances</span>
    </a>

    <nav>
        <a class="bodyText" href="#whywe">Why We</a>
        <a class="bodyText" href="#process">Process</a>
        <a class="bodyText" href="#faqs">FAQs</a>
        <a class="bodyText" href="#privacy-policy">Privacy Policy</a>
    </nav>
    <div class={styles.actions}>
        <button data-login class={`${button.btn} ${button.outlineLight} ${button.sm}`}>
            <p class="buttonText">Log in</p>
        </button>
        <button data-signup class={`${button.btn} ${button.vibrant} ${button.sm} ${button.icon}`} style={`--icon: url(${LogoIcon.src});`}>
            <p class="buttonText">Start playing</p>
        </button>
    </div>
</header>