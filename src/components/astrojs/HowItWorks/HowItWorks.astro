---
import styles from "./HowItWorks.module.css";
---

<section id="process" class={styles.container}>
    <div class={styles.content}>
        <h2 class="h2">From "let's play tonight" to playing — in about a minute.</h2>
        <p class="subTitle">No installs. No infrastructure. Same flow every time.</p>

        <div class={styles.steps}>
            <div class={styles.step}>
                <div>
                    <p class="subtitleSemiBig">01</p>
                </div>
                <h4 class="subtitleSemi">Pick your game</h4>
                <p class="bodyText">Choose a game and any modpack you want. We support everything from vanilla Minecraft to deep modded packs.</p>
            </div>

            <div class={styles.step}>
                <div>
                    <p class="subtitleSemiBig">02</p>
                </div>
                <h4 class="subtitleSemi">Pick a region</h4>
                <p class="bodyText">Servers run in every major region so everyone in your group gets low ping. Move them anytime.</p>
            </div>

            <div class={styles.step}>
                <div>
                    <p class="subtitleSemiBig">03</p>
                </div>
                <h4 class="subtitleSemi">Click start</h4>
                <p class="bodyText">Your server boots in seconds. Share the address with your friends — or invite them in-app.</p>
            </div>

            <div class={styles.step}>
                <div>
                    <p class="subtitleSemiBig">04</p>
                </div>
                <h4 class="subtitleSemi">Play, walk away</h4>
                <p class="bodyText">When you're done, just close the game. We pause the server automatically and stop the meter.</p>
            </div>
        </div>

    </div>
</section>