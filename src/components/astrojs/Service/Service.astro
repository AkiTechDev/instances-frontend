---
import styles from "./Service.module.css";
---

<section class={styles.container}>
    <h2 class="h2">Built for people who just want to <span class="gradFun">play</span></h2>

    <div class={styles.services}>
        <div class={styles.card}>
            <div>
                <p class="bodyTextSmallestSemiCaps">01 — ONE-CLICK</p>
            </div>
            <h3 class="h6">From signup to playing in 60 seconds.</h3>
            <p class="bodyText">Pick a game, name your server, click Start. We do the rest. No DNS, no port-forwarding, no Discord posts asking who has admin.</p>
            <a class="bodyTextSmallestSemiCaps" href="#process">See how it works →</a>
        </div>

        <div class={styles.card}>
            <div>
                <p class="bodyTextSmallestSemiCaps">02 — AUTO-SLEEP</p>
            </div>
            <h3 class="h6">Idle servers pause themselves.</h3>
            <p class="bodyText">When the last friend logs off, your server quietly puts itself to bed. The minute someone joins, it wakes back up. You never pay for empty servers.</p>
            <a class="bodyTextSmallestSemiCaps" href="#process">Learn about billing →</a>
        </div>

        <div class={styles.card}>
            <div>
                <p class="bodyTextSmallestSemiCaps">03 — PAY-AS-YOU-GO</p>
            </div>
            <h3 class="h6">Around $0.30 / hour. Cancel anytime.</h3>
            <p class="bodyText">No monthly subscription. No 12-month commitment. You're billed for the hours your server is up — and you can download your world and walk away whenever you want.</p>
            <a class="bodyTextSmallestSemiCaps" href="#process">See pricing →</a>
        </div>
    </div>
</section>