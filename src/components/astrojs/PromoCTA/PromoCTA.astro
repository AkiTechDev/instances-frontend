---
import styles from "./PromoCTA.module.css";
import button from "../../../styles/components/button.module.css";

import PresentIcon from "../../../assets/icons/present.svg";
---

<section class={styles.container}>
    <PresentIcon />
    <div class={styles.cta}>
        <div class={styles.content}>
            <h1 class="h1Caps">
                Get Your First Server Hour <span class={styles.free}>Free</span> - <span class={styles.credit}>No Credit Card</span> Required!
            </h1>
            <p class="subTitle">
                Spin up your first game server today and see how easy multiplayer hosting can be.
            </p>
        </div>
        <button class={`${button.btn} ${button.vibrant} buttonText`}>
            Start Playing Now
        </button>
    </div>
    <PresentIcon />
</section>