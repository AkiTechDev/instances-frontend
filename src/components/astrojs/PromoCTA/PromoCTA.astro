---
import styles from "./PromoCTA.module.css";
import button from "../../../styles/components/button.module.css";

import PresentIcon from "../../../assets/icons/present.svg";
---

<section class={styles.container}>
    <PresentIcon class={styles.present} />
    <div class={styles.cta}>
        <div class={styles.content}>
            <h2 class="h1Caps">
                SIGN UP FOR OUR <br /><span class={styles.free}>FREE TRIAL</span> WAITLIST - <span class={styles.credit}>NO CREDIT CARD REQUIRED!</span>
            </h2>
            <p class="subTitle">
                Spin up your first game server today and see how easy multiplayer hosting can be.
            </p>
        </div>
        <button data-signup class={`${button.btn} ${button.vibrant} buttonText`}>
            Start Playing Now
        </button>
    </div>
    <PresentIcon class={`${styles.present}`} />
</section>