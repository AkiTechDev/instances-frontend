---
import styles from "./Hero.module.css";
import button from "../../../styles/components/button.module.css";

//import HeroAsset from "../../../assets/landingIcon.svg";
//import MinecraftDiorama from "../assets/minecraftDiorama.svg";
//import MinecraftDiorama from "../../../assets/images/minecraft.png";
import WelcomeToInstances from "../../../assets/images/WelcomeToInstances.png";
---

<section class={styles.container} style={`--icon: url("")`}>
    <div class={styles.content}>
        <h1 class="h1">We handle the servers. <span class={styles.gradFun}>You handle the fun.</span></h1>
        <p class="subText">Play instantly with friends, no setup, no subscriptions, just pay when you play.</p>
        <div class={styles.actions}>
            <button data-login class={`${button.btn} ${button.vibrant}`}>
                <p class="buttonText">Start Playing Now</p>
            </button>
            <a href="#process" class={`${button.btn} ${button.outlineLight}`}>
                <p class="buttonText">Learn More</p>
            </a>
        </div>
    </div>
    <img src={WelcomeToInstances.src} />
</section>