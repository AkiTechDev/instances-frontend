---
import { Picture } from "astro:assets";

import styles from "./Hero.module.css";
import button from "../../../styles/components/button.module.css";

//import HeroAsset from "../../../assets/landingIcon.svg";
//import MinecraftDiorama from "../assets/minecraftDiorama.svg";
//import MinecraftDiorama from "../../../assets/images/minecraft.png";
import WelcomeToInstances from "../../../assets/images/WelcomeToInstances.png";
---

<section class={styles.container} style={`--icon: url("")`}>
    <div class={styles.content}>
        <h1 class="h1">We handle the servers. <span class={styles.gradFun}>You handle the fun.</span></h1>
        <p class="subText">Play instantly with friends, no setup, no subscriptions, just pay when you play.</p>
        <div class={styles.actions}>
            <button data-login class={`${button.btn} ${button.vibrant}`}>
                <p class="buttonText">Start Playing Now</p>
            </button>
            <a href="#process" class={`${button.btn} ${button.outlineLight}`}>
                <p class="buttonText">Learn More</p>
            </a>
        </div>
    </div>
    <!-- Largest contentful paint on the busiest page: eager + high priority so it
         isn't queued behind the island's JS, and width/height so the box is
         reserved before the bytes land. The picture element carries the 50%
         column because it, not the img, is the flex item.

         `sizes` tracks the three layouts in Hero.module.css, so the browser is
         not still sizing for a 50% column after the section has stacked: above
         98rem the container is capped and the column is a flat 688px; 1101-1567
         the edge padding is 5rem a side; 761-1100 it is 2rem; below that the
         image is the full column at 1.25rem a side. Getting this wrong is silent
         -- the picture just resolves to a 400w candidate and looks soft. -->
    <Picture
        src={WelcomeToInstances}
        formats={["avif", "webp"]}
        widths={[400, 688, 1032, 1376]}
        sizes="(min-width: 98rem) 688px,
               (min-width: 1101px) calc(50vw - 6rem),
               (min-width: 761px) calc(50vw - 3rem),
               calc(100vw - 4.5rem)"
        width={1200}
        height={800}
        alt="A blocky, Minecraft-style grass island where a waving player character greets you with 'Welcome to Instances!', joined by a pig, a sheep, a tree and flowers."
        loading="eager"
        fetchpriority="high"
        decoding="async"
        pictureAttributes={{ class: styles.media }}
        class={styles.mediaImage}
    />
</section>