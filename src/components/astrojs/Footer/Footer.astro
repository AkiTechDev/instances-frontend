<!-- Footer.astro -->
---
import styles from './Footer.module.css';

import LogoIcon from "../../../assets/icons/logos/icon.svg";
import facebookIcon from "../../../assets/icons/socials/facebook.svg";
import instagramIcon from "../../../assets/icons/socials/instragram.svg";
import discordIcon from "../../../assets/icons/socials/discord.svg";
---

<section class={styles.section}>
    <div class={styles.contentContainer}>
        <div class={styles.nav}>
            <a class="bodyText" href="#services">Why We</a>
            <a class="bodyText" href="#games">Games</a>
            <a class="bodyText" href="#faqs">FAQs</a>
            <a class="bodyText" href="/privacy-policy">Privacy Policy</a>
        </div>

        <div class={styles.banner}>
            <div class={styles.squareLogo}>
                <a href="/" target="_self">
                    <LogoIcon width={104} height={104} style={`--path2: white`} />
                </a>
                <p>instances</p>
            </div>
            <div class={styles.socialMedia}>
                <a href="https://www.facebook.com/profile.php?id=61567620143464" target="_blank">
                    <div class:list={styles.icon} style={`--icon: url(${facebookIcon.src})`}></div>
                </a>
                <a href="https://www.instagram.com/aki_labs" target="_blank">
                    <div class:list={styles.icon} style={`--icon: url(${instagramIcon.src})`}></div>
                </a>
                <a href="https://discord.gg/nhCEXaZVMX" target="_blank">
                    <div class:list={styles.icon} style={`--icon: url(${discordIcon.src})`}></div>
                </a>
            </div>
        </div>

        <div class={styles.contact}>
            <div class={styles.contactBlock}>
                <label class="bodyText">E-mail</label>
                <a href="mailto:aki@aki-labs.com" class="bodyText">aki@aki-labs.com</a>
            </div>
            <div class={styles.contactBlock}>
                <label class="bodyText">Instagram</label>
                <a href="https://www.instagram.com/aki_labs" target="_blank" class="bodyText">@aki_labs</a>
            </div>
        </div>
    </div>
    <p class="bodyTextSmallest">©2026 Instances. Powered by <span style="color: var(--c-orange);">Aki Laboratories</span>.</p>
</section>