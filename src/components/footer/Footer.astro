<!-- Footer.astro -->
---
import styles from './footer.module.css';

import footerIcon from "./assets/footerIcon.svg?url";
import facebookIcon from "./assets/facebookIcon.svg";
import instagramIcon from "./assets/instagramIcon.svg";
import discordIcon from "./assets/discordIcon.svg";
---

<section class={styles.section}>
    <div class={styles.contentContainer}>
        <div class={styles.nav}>
            <a class="bodyText" href="#whywe">Why We</a>
            <a class="bodyText" href="#process">Process</a>
            <a class="bodyText" href="#faqs">FAQs</a>
            <a class="bodyText" href="#privacy-policy">Privacy Policy</a>
        </div>

        <div class={styles.banner}>
            <img src={footerIcon} />
            <div class={styles.socialMedia}>
                <a href="https://www.facebook.com/profile.php?id=61567620143464" target="_blank">
                    <div class:list={[styles.facebookContact, styles.bannerContactIcon]} style={`--facebookIconUrl: url(${facebookIcon.src})`}></div>
                </a>
                <a href="https://www.instagram.com/aki_labs" target="_blank">
                    <div class:list={[styles.instagramIcon, styles.bannerContactIcon]} style={`--instagramIconUrl: url(${instagramIcon.src})`}></div>
                </a>
                <a href="https://discord.gg/nhCEXaZVMX" target="_blank">
                    <div class:list={[styles.discordIcon, styles.bannerContactIcon]} style={`--discordIconUrl: url(${discordIcon.src})`}></div>
                </a>
            </div>
        </div>

        <div class={styles.contact}>
            <div class={styles.contactBlock}>
                <label class="bodyText">E-mail</label>
                <a href="mailto:aki@aki-labs.com" class="bodyText">aki@aki-labs.com</a>
            </div>
            <div class={styles.contactBlock}>
                <label class="bodyText">Instagram</label>
                <a href="https://www.instagram.com/aki_labs" target="_blank" class="bodyText">@aki_labs</a>
            </div>
        </div>
    </div>
    <p class="bodyTextSmallest">©2026 Instances. Powered by Aki Laboratories.</p>
</section>