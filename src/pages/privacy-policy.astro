</style>

<style>
    /* Long-form legal reading on the dark brand background.

       Three things drive every decision here:
       1. Findability — a 16-section policy is scanned, not read start to end,
          so the contents nav is sticky and every heading is a stable anchor.
       2. Measure — the design system's 130% body line-height is tuned for UI
          labels, not prose. The article relaxes it to 1.7 and caps the column
          width; anything wider becomes hard to track back across.
       3. Honesty — `.pending` is deliberately loud. An unfilled value must be
          impossible to miss in review and embarrassing (not invisible) if it
          ever ships. */

    .page {
        /* The site Header is `position: sticky; top: 0`, so anything else that
           sticks — and every anchor target — has to clear it or it lands
           underneath. 94px at desktop widths, taller once its nav wraps, so the
           script below measures it; this value is the pre-hydration fallback. */
        --header-h: 5.875rem;

        --hairline:      rgba(239, 241, 255, 0.12);
        --hairline-soft: rgba(239, 241, 255, 0.07);
        --ink-body:      rgba(255, 255, 255, 0.82);
        --ink-muted:     rgba(255, 255, 255, 0.55);

        /* The landing page's card recipe, kept identical so legal pages sit in
           the same material as the rest of the site. */
        --surface: linear-gradient(295.31deg, rgba(14, 19, 44, 0.2) 4.75%, rgba(48, 58, 106, 0.2) 86.61%);
        --surface-inset: inset 1px 1px 2px rgba(255, 255, 255, 0.05);

        width: min(100% - 2rem, 96rem); /* 1536px */
        margin-inline: auto;
        padding: 3.5rem var(--padding-sm) 5rem;
        box-sizing: border-box;

        color: var(--text-colour-light);
    }

    /* ── Dev-only pre-publication checklist ──────────────────────────────── */

    .devChecklist {
        margin-bottom: 3rem;
        padding: 1.25rem 1.5rem;
        border: 1px dashed var(--c-orange);
        border-radius: var(--r-card);
        background: rgba(235, 164, 57, 0.08);
    }

    .devChecklist > p:first-child { color: var(--c-orange); margin: 0 0 0.75rem; }
    .devChecklist ul { margin: 0; padding-left: 1.25rem; display: grid; gap: 0.375rem; }
    .devChecklist li { color: var(--ink-body); }
    .devChecklist li::marker { color: var(--c-orange); }
    .devChecklist > p:last-child { margin: 0.875rem 0 0; color: var(--ink-muted); }
    .devChecklist code { font-size: 0.9em; }

    /* ── Hero ────────────────────────────────────────────────────────────── */

    .hero {
        max-width: 46rem;
        padding-bottom: 3.5rem;
        border-bottom: 1px solid var(--hairline);
        margin-bottom: 3.5rem;
    }

    .eyebrow { color: var(--c-orange); margin: 0 0 0.75rem; }
    .hero h1 { margin: 0 0 1.25rem; }
    .heroLead { margin: 0; color: var(--ink-body); line-height: 1.6; }

    .heroMeta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.75rem;
        color: var(--ink-muted);
    }

    .heroMeta p { margin: 0; }
    .metaDot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-muted); }

    .jumpTo { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: 1.75rem; }

    .jumpTo a {
        padding: 0.5rem 1rem;
        border: 1px solid var(--hairline);
        border-radius: var(--r-pill);
        color: var(--text-colour-light);
        text-decoration: none;
        transition: border-color var(--dur-fast) var(--ease-out),
                    color        var(--dur-fast) var(--ease-out),
                    background   var(--dur-fast) var(--ease-out);
    }

    .jumpTo a:hover { border-color: var(--c-orange); color: var(--c-orange); background: rgba(235, 164, 57, 0.08); }

    /* ── Two-column layout ───────────────────────────────────────────────── */

    .layout {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: 4rem;
        align-items: start;
    }

    /* ── Contents ────────────────────────────────────────────────────────── */

    .tocDesktop {
        position: sticky;
        top: calc(var(--header-h) + 1.5rem);
        max-height: calc(100vh - var(--header-h) - 3rem);
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .tocTitle { color: var(--ink-muted); margin: 0 0 1rem; }

    .tocDesktop ol,
    .tocMobile ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.125rem; }

    .tocDesktop a,
    .tocMobile a {
        display: grid;
        grid-template-columns: 1.5rem 1fr;
        gap: 0.5rem;
        padding: 0.4375rem 0.625rem;
        border-radius: var(--r-sm);
        border-left: 2px solid transparent;
        color: var(--ink-muted);
        text-decoration: none;
        transition: color var(--dur-fast) var(--ease-out),
                    background var(--dur-fast) var(--ease-out);
    }

    .tocDesktop a:hover,
    .tocMobile a:hover { color: var(--text-colour-light); background: rgba(255, 255, 255, 0.04); }

    .tocDesktop a[aria-current="true"],
    .tocMobile a[aria-current="true"] {
        color: var(--c-orange);
        border-left-color: var(--c-orange);
        background: rgba(235, 164, 57, 0.08);
    }

    .tocNum { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
    .tocDesktop a[aria-current="true"] .tocNum { color: var(--c-orange); }
    .tocText { text-wrap: balance; }

    .tocMobile { display: none; }

    .tocMobile {
        border: 1px solid var(--hairline);
        border-radius: var(--r-card);
        background: var(--surface);
        box-shadow: var(--surface-inset);
        margin-bottom: 2.5rem;
    }

    .tocMobile summary {
        list-style: none;
        cursor: pointer;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tocMobile summary::-webkit-details-marker { display: none; }

    .tocChevron {
        width: 0.5rem; height: 0.5rem;
        border-right: 2px solid var(--c-orange);
        border-bottom: 2px solid var(--c-orange);
        transform: rotate(45deg) translate(-2px, -2px);
        transition: transform var(--dur-normal) var(--ease-out);
    }

    .tocMobile[open] .tocChevron { transform: rotate(-135deg) translate(-2px, -2px); }
    .tocMobile ol { padding: 0 0.625rem 1rem; }

    /* ── Prose ───────────────────────────────────────────────────────────── */

    .prose { max-width: 50rem; }

    .prose section { margin-bottom: 3.5rem; }

    .prose h2 {
        display: flex;
        align-items: baseline;
        gap: 0.875rem;
        margin: 0 0 1.25rem;
        scroll-margin-top: calc(var(--header-h) + 1rem);
        text-wrap: balance;
    }

    .sectionNum {
        flex: none;
        color: var(--c-orange);
        font-size: 1.125rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .prose h3 { margin: 2.25rem 0 0.875rem; color: var(--text-colour-light); }

    /* The design system's body line-height (130%) is set for UI labels. Prose
       needs the extra leading to stay readable across a 50rem column. */
    .prose p,
    .prose li,
    .prose td,
    .prose dd { line-height: 1.7; color: var(--ink-body); }

    .prose p { margin: 0 0 1rem; }
    .prose strong { color: var(--text-colour-light); font-weight: 600; }

    .prose a {
        color: var(--c-orange);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        transition: color var(--dur-fast) var(--ease-out);
    }

    .prose a:hover { color: var(--c-purple); }

    .prose code {
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.8125rem;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.07);
        overflow-wrap: anywhere;
    }

    .muted { color: var(--ink-muted); }

    /* ── Unresolved values ───────────────────────────────────────────────── */

    .pending {
        display: inline;
        padding: 0.0625rem 0.375rem;
        border: 1px dashed var(--c-orange);
        border-radius: 4px;
        background: rgba(235, 164, 57, 0.12);
        color: var(--c-orange);
        font-weight: 500;
    }

    .pending::before { content: "["; }
    .pending::after  { content: "]"; }

    /* ── Callouts ────────────────────────────────────────────────────────── */

    .callout {
        margin: 1.5rem 0;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--c-purple);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
        background: rgba(197, 137, 244, 0.08);
    }

    .callout--warn { border-left-color: var(--c-orange); background: rgba(235, 164, 57, 0.09); }
    .callout--good { border-left-color: var(--c-green-bright); background: rgba(128, 247, 51, 0.07); }

    /* ── §1 company facts ────────────────────────────────────────────────── */

    .factGrid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        margin: 1.5rem 0;
        padding: 0;
        border: 1px solid var(--hairline);
        border-radius: var(--r-card);
        background: var(--hairline-soft);
        overflow: hidden;
    }

    .fact { padding: 1rem 1.25rem; background: #1E2237; }
    .fact dt { color: var(--ink-muted); margin-bottom: 0.375rem; }
    .fact dd { margin: 0; }

    /* ── §3 approach ─────────────────────────────────────────────────────── */

    .approachGrid {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: 1rem;
    }

    .approachCard {
        position: relative;
        padding: 1.25rem 1.25rem 1.25rem 3.25rem;
        border-radius: var(--r-card);
        background: var(--surface);
        box-shadow: var(--surface-inset);
    }

    .approachCard::before {
        content: "";
        position: absolute;
        top: 1.375rem;
        left: 1.25rem;
        width: 1.125rem;
        height: 1.125rem;
        background-color: var(--c-green-bright);
        -webkit-mask: var(--tick) no-repeat center / contain;
        mask: var(--tick) no-repeat center / contain;
    }

    .approachCard p { margin: 0; }

    /* ── Tables ──────────────────────────────────────────────────────────── */

    .tableScroll {
        margin: 1.5rem 0;
        overflow-x: auto;
        border: 1px solid var(--hairline);
        border-radius: var(--r-card);
    }

    .tableScroll:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    .dataTable { width: 100%; border-collapse: collapse; text-align: left; }

    .dataTable th {
        padding: 0.875rem 1.125rem;
        border-bottom: 1px solid var(--hairline);
        background: rgba(255, 255, 255, 0.03);
        color: var(--ink-muted);
        font-family: var(--font-bodyTextSmallestSemiCaps-family);
        font-weight: var(--font-bodyTextSmallestSemiCaps-weight);
        font-size: var(--font-bodyTextSmallestSemiCaps-size);
        text-transform: uppercase;
        white-space: nowrap;
    }

    .dataTable td {
        padding: 0.875rem 1.125rem;
        border-bottom: 1px solid var(--hairline-soft);
        font-size: var(--font-bodyTextSmall-size);
        vertical-align: top;
    }

    .dataTable tbody tr:last-child td { border-bottom: none; }
    .dataTable tbody tr:nth-child(even) { background: rgba(255, 255, 255, 0.02); }

    /* Legal-basis pills — colour-coded so the table can be skimmed by basis. */
    .basis {
        display: inline-block;
        padding: 0.1875rem 0.5rem;
        border-radius: var(--r-pill);
        font-size: var(--font-bodyTextSmallest-size);
        font-weight: 600;
        white-space: nowrap;
    }

    .basis--contract   { background: rgba(133, 182, 255, 0.15); color: var(--c-blue-sky); }
    .basis--interest   { background: rgba(197, 137, 244, 0.15); color: var(--c-purple); }
    .basis--obligation { background: rgba(235, 164, 57, 0.15);  color: var(--c-orange); }
    .basis--consent    { background: rgba(128, 247, 51, 0.15);  color: var(--c-green-bright); }

    /* ── §7 — the section customers most need to read ────────────────────── */

    .keySection {
        padding: 2rem;
        border-radius: var(--r-card);
        background: rgba(235, 164, 57, 0.04);
        box-shadow: inset 0 0 0 1px rgba(235, 164, 57, 0.18);
    }

    .keySection > :last-child { margin-bottom: 0; }

    .labelledBlock {
        margin: 1.5rem 0;
        padding-left: 1.25rem;
        border-left: 2px solid var(--hairline);
    }

    .labelledBlock--emphasis { border-left-color: var(--c-orange); }
    .labelledBlock .blockLabel { margin: 0 0 0.625rem; color: var(--c-orange); }
    .labelledBlock > :last-child { margin-bottom: 0; }

    /* ── Lists ───────────────────────────────────────────────────────────── */

    .markerList { margin: 0 0 1rem; padding-left: 1.25rem; display: grid; gap: 0.5rem; }
    .markerList li::marker { color: var(--c-orange); }

    .tickList { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 0.75rem; }

    .tickList li { position: relative; padding-left: 2rem; }

    .tickList li::before {
        content: "";
        position: absolute;
        top: 0.3125rem;
        left: 0;
        width: 1.125rem;
        height: 1.125rem;
        background-color: var(--c-green-bright);
        -webkit-mask: var(--tick) no-repeat center / contain;
        mask: var(--tick) no-repeat center / contain;
    }

    /* §9 — term and explanation read as one sentence, so they flow inline. */
    .whereList { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 1rem; }

    .whereList li {
        padding: 1rem 1.25rem;
        border-radius: var(--r-sm);
        background: rgba(255, 255, 255, 0.03);
    }

    .whereList p { display: inline; margin: 0; }
    .whereWhat { color: var(--text-colour-light); font-weight: 600; }

    /* ── §11 rights ──────────────────────────────────────────────────────── */

    .rightsGrid {
        list-style: none;
        margin: 1.5rem 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: 1rem;
    }

    .rightCard {
        padding: 1.125rem 1.25rem;
        border-radius: var(--r-card);
        background: var(--surface);
        box-shadow: var(--surface-inset);
    }

    .rightCard .rightName { margin: 0 0 0.375rem; color: var(--c-orange); }
    .rightCard p:last-child { margin: 0; color: var(--ink-body); }

    /* ── §16 regions ─────────────────────────────────────────────────────── */

    .regionGrid {
        list-style: none;
        margin: 1.5rem 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        gap: 1rem;
    }

    .regionCard {
        padding: 1.25rem;
        border-radius: var(--r-card);
        background: var(--surface);
        box-shadow: var(--surface-inset);
    }

    .regionCard .regionName { margin: 0 0 0.5rem; color: var(--text-colour-light); }
    .regionCard p:last-child { margin: 0; }

    /* ── §15 CTA + article footer ────────────────────────────────────────── */

    .contactCta { margin-top: 1.5rem; }
    .contactCta a { text-decoration: none; }

    .proseFooter {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 2rem;
        border-top: 1px solid var(--hairline);
    }

    .proseFooter p { margin: 0; color: var(--ink-muted); }

    .backToTop {
        color: var(--c-orange);
        text-decoration: none;
        white-space: nowrap;
    }

    .backToTop:hover { color: var(--c-purple); }

    /* ── Shared ──────────────────────────────────────────────────────────── */

    .visuallyHidden {
        position: absolute;
        width: 1px; height: 1px;
        margin: -1px; padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .prose a:focus-visible,
    .jumpTo a:focus-visible,
    .tocDesktop a:focus-visible,
    .tocMobile a:focus-visible,
    .tocMobile summary:focus-visible {
        outline: var(--focus-ring);
        outline-offset: var(--focus-ring-offset);
        border-radius: 4px;
    }

    /* ── Responsive ──────────────────────────────────────────────────────── */

    @media screen and (max-width: 1100px) {
        .page { padding: 2.5rem 2rem 4rem; }
        .layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
        .tocDesktop { display: none; }
        .tocMobile { display: block; }
        .prose { max-width: none; }
    }

    @media screen and (max-width: 760px) {
        .page { padding: 2rem 1.25rem 3rem; }
        .hero h1 { font-size: 2.5rem; }
        .hero { padding-bottom: 2.5rem; margin-bottom: 2.5rem; }
        .prose h2 { font-size: 1.5rem; line-height: 1.3; }
        .factGrid { grid-template-columns: minmax(0, 1fr); }
        .prose h3 { font-size: 1.125rem; }
        .prose section { margin-bottom: 2.5rem; }
        .keySection { padding: 1.25rem; }

        /* Stack table rows into labelled cards — a four-column table on a phone
           is unreadable either scrolled or squeezed. */
        .tableScroll { border: none; overflow-x: visible; }
        .dataTable thead { display: none; }
        .dataTable, .dataTable tbody, .dataTable tr, .dataTable td { display: block; width: 100%; }

        .dataTable tbody tr {
            margin-bottom: 0.875rem;
            padding: 0.25rem 1rem;
            border: 1px solid var(--hairline);
            border-radius: var(--r-sm);
            box-sizing: border-box;
        }

        .dataTable tbody tr:nth-child(even) { background: none; }

        .dataTable td {
            padding: 0.6875rem 0;
            border-bottom: 1px solid var(--hairline-soft);
        }

        .dataTable tbody tr td:last-child { border-bottom: none; }

        /* The label is a block above the value rather than a grid column: a cell
           can hold several inline children (a muted qualifier, two basis pills),
           and each would otherwise become its own grid item and wrap into the
           label column. */
        .dataTable td::before {
            content: attr(data-label);
            display: block;
            margin-bottom: 0.25rem;
            color: var(--ink-muted);
            font-size: var(--font-bodyTextSmallest-size);
            text-transform: uppercase;
        }
    }

    /* ── Print ───────────────────────────────────────────────────────────── */

    @media print {
        .page { padding: 0; width: auto; color: #000; }
        .devChecklist, .tocDesktop, .tocMobile, .jumpTo, .contactCta, .backToTop { display: none; }
        .layout { display: block; }
        .prose { max-width: none; }
        .prose p, .prose li, .prose td, .prose dd, .heroLead { color: #000; }
        .prose a { color: #000; }
        .prose section { break-inside: avoid-page; margin-bottom: 2rem; }
        .prose h2, .prose h3 { break-after: avoid-page; color: #000; }
        .approachCard, .rightCard, .regionCard, .fact, .keySection, .whereList li {
            background: none; box-shadow: none; border: 1px solid #999;
        }
        .callout { background: none; border-left-color: #000; }
        .dataTable th, .dataTable td { border-color: #999; color: #000; }
    }
</style>

<script>
    /* Contents scrollspy.

       rootMargin pins the "active" band to the upper third of the viewport, so
       the highlighted entry is the heading you are actually reading rather than
       whichever one happens to be closest to the fold. Both copies of the nav
       (sticky sidebar + mobile disclosure) are updated together. */

    const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-toc] a[href^='#']"),
    );
    const headings = Array.from(document.querySelectorAll<HTMLElement>(".prose h2[id]"));

    if (import.meta.env.DEV) {
        const linked = new Set(links.map((a) => a.hash.slice(1)));
        const missing = headings.filter((h) => !linked.has(h.id)).map((h) => h.id);
        const dangling = [...linked].filter((id) => !document.getElementById(id));
        if (missing.length || dangling.length) {
            console.warn(
                "[privacy-policy] contents nav is out of step with the headings.",
                { headingsNotInNav: missing, navEntriesWithNoHeading: dangling },
            );
        }
    }

    if (links.length && headings.length) {
        const setActive = (id: string) => {
            for (const link of links) {
                if (link.hash.slice(1) === id) link.setAttribute("aria-current", "true");
                else link.removeAttribute("aria-current");
            }
        };

        const visible = new Set<string>();

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) visible.add(entry.target.id);
                    else visible.delete(entry.target.id);
                }

                // Document order wins, so scrolling up lands on the heading you
                // scrolled back into rather than the last one to leave the band.
                const first = headings.find((h) => visible.has(h.id));
                if (first) setActive(first.id);
            },
            { rootMargin: "0px 0px -66% 0px", threshold: 0 },
        );

        for (const heading of headings) observer.observe(heading);

        // Clicking an entry should highlight it immediately, before the scroll
        // animation has moved the heading into the observed band.
        for (const link of links) {
            link.addEventListener("click", () => setActive(link.hash.slice(1)));
        }
    }

    /* Keep --header-h in step with the sticky Header's real height: it grows
       when the nav wraps, and a stale value parks jumped-to headings behind it. */
    const page = document.querySelector<HTMLElement>(".page");
    const siteHeader = document.querySelector<HTMLElement>("body > header");

    if (page && siteHeader) {
        const syncHeaderHeight = () => {
            const h = siteHeader.getBoundingClientRect().height;
            if (h > 0) page.style.setProperty("--header-h", `${h}px`);
        };
        syncHeaderHeight();
        new ResizeObserver(syncHeaderHeight).observe(siteHeader);
    }

    // Collapse the mobile contents once a destination is chosen.
    const mobileToc = document.querySelector<HTMLDetailsElement>(".tocMobile");
    mobileToc?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) mobileToc.open = false;
    });
</script>
