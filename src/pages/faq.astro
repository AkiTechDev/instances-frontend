---
// Order matters: tokens (theme/default) before the sheets that consume them,
// and identical on every entry point so the cascade can't diverge per page.
import Fonts from "../components/Fonts.astro";

import "../styles/normalise.css"
import "../styles/global.css"
import "../styles/theme/default.css"
import "../styles/typography.css"

import button from "../styles/components/button.module.css";

import Header from "../components/astrojs/header/Header.astro";
import Newsletter from "../components/newsletter/Newsletter.astro";
import Footer from "../components/astrojs/Footer/Footer.astro";

import { faqsByCategory, faqPageLd, faqs } from "../lib/faqs";
import { SUPPORT_EMAIL, DISCORD_INVITE } from "../lib/support";

const groups = faqsByCategory();

/* Every answer on this page is visible on load — the filter only hides — so
   the structured data describes what a reader actually gets. */
const faqLd = faqPageLd();

/* Anchor ids are published: people link to /faq#stopped-server-charges, and a
   renamed id is a dead link somewhere we can't see. Duplicates would be worse
   — two answers fighting over one anchor — so they're caught at build time. */
const ids = faqs.map((faq) => faq.id);
const duplicates = ids.filter((id, i) => ids.indexOf(id) !== i);
if (duplicates.length) {
    console.warn("[faq] duplicate question ids — anchors will collide.", duplicates);
}

/* The landing page renders the `landing` subset from the same source. If that
   subset is ever emptied the accordion silently disappears from the homepage,
   which is the sort of thing nobody notices for a month. */
if (!faqs.some((faq) => faq.landing)) {
    console.warn("[faq] no questions are marked `landing` — the homepage accordion will be empty.");
}

const domain = "instances.aki-labs.com";
const url = `https://${domain}/faq`;
const title = "Questions and answers | Instances";
const seo_des = "How pay-as-you-play game servers work, what happens when you stop one, which games we host, and how to reach a person when something goes wrong.";
---
<!doctype html>
<html lang="en" class="en" prefix="og: http://ogp.me/ns#">
    <head>
        <meta charset="UTF-8" />

        <Fonts />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="author" content="Aki Laboratories Limited">
        <meta name="referrer" content="strict-origin-when-cross-origin">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO -->
        <title>{title}</title>
        <meta name="description" content={seo_des}>
        <meta itemprop="description" content={seo_des}>
        <meta name="robots" content="all" />
        <link rel="canonical" href={url}>
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Twitter/X specific -->
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={seo_des}>
        <meta name="twitter:site" content="@aki_labs">

        <!-- Open Graph -->
        <meta property="og:title" content={title}>
        <meta property="og:description" content={seo_des}>
        <meta property="og:type" content="website">
        <meta property="og:url" content={url}>
        <meta property="og:site_name" content="Instances">
        <meta property="og:locale" content="en_US">

        <!-- Mobile / Browser theming -->
        <meta name="theme-color" content="#191C2E">
        <meta name="apple-mobile-web-app-capable" content="yes">

        <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />
    </head>
    <body>
        <Header />

        <main class="page">
            <!-- ── Masthead ─────────────────────────────────────────────── -->
            <header class="masthead">
                <p class="eyebrow bodyTextSmallestSemiCaps">Help</p>
                <h1 class="h2">Questions and answers</h1>
                <p class="subTitle lead">
                    Written for people who have never rented a server before. If your
                    question isn't here, ask us &mdash; that's how most of these got written.
                </p>

                <!-- Revealed by the filter script; without it the page is simply
                     the whole document, which is the useful fallback. -->
                <div class="tools" data-faq-tools hidden>
                    <div class="searchWrap">
                        <label class="srOnly" for="faqSearch">Search the questions</label>
                        <input
                            id="faqSearch"
                            class="search bodyText"
                            type="search"
                            placeholder="Search — try &ldquo;cost&rdquo; or &ldquo;mods&rdquo;"
                            autocomplete="off"
                            data-faq-search
                        />
                        <button type="button" class="clear" data-faq-clear hidden>
                            <span class="srOnly">Clear search</span>
                        </button>
                    </div>
                    <p class="count bodyTextSmall" role="status" aria-live="polite" data-faq-count></p>
                </div>

                <nav class="chips" aria-label="Jump to a section">
                    {groups.map(({ category }) => (
                        <a href={`#${category.id}`} class="bodyTextSmallSemi" data-faq-jump>
                            {category.title}
                        </a>
                    ))}
                </nav>
            </header>

            <!-- ── The answers ──────────────────────────────────────────── -->
            <div class="doc">
                {groups.map(({ category, items }) => (
                    <section class="group" id={category.id} aria-labelledby={`${category.id}-title`} data-faq-group>
                        <div class="groupHead">
                            <h2 id={`${category.id}-title`} class="h5">{category.title}</h2>
                            <p class="bodyText groupBlurb">{category.blurb}</p>
                        </div>

                        <div class="items">
                            {items.map((faq) => (
                                <article class="qa" id={faq.id} data-faq-item data-search={`${faq.q} ${faq.a.join(" ")}`.toLowerCase()}>
                                    <h3 class="subtitleSemi qaQ">
                                        <a href={`#${faq.id}`} class="qaAnchor">{faq.q}</a>
                                    </h3>
                                    <div class="qaA">
                                        {faq.a.map((para) => <p class="bodyText">{para}</p>)}
                                        {faq.links && faq.links.length > 0 && (
                                            <p class="qaLinks bodyTextSmallSemi">
                                                {faq.links.map((link) => (
                                                    <a href={link.href} data-faq-jump>{link.label}</a>
                                                ))}
                                            </p>
                                        )}
                                    </div>
                                </article>
                            ))}
                        </div>
                    </section>
                ))}

                <!-- Only ever shown by the filter script. -->
                <section class="empty" data-faq-empty hidden aria-live="polite">
                    <h2 class="h6">Nothing here matches <span class="term" data-faq-term></span></h2>
                    <p class="bodyText">
                        That might be our fault rather than yours &mdash; if it's a fair question
                        and we haven't answered it, we'd like to know.
                    </p>
                    <a href="/contact?topic=question" class:list={[button.btn, button.outline]}>
                        <span class="buttonText">Ask us instead</span>
                    </a>
                </section>
            </div>

            <!-- ── Closing ──────────────────────────────────────────────── -->
            <section class="closing" aria-labelledby="closing-title">
                <div class="closingCopy">
                    <h2 id="closing-title" class="h6">Still stuck?</h2>
                    <p class="bodyText">
                        A real person reads all three of these. Discord is usually quickest,
                        because other players answer too.
                    </p>
                </div>
                <ul class="routes">
                    <li>
                        <a href={DISCORD_INVITE} target="_blank" rel="noopener noreferrer">
                            <span class="routeName subtitleSemi">Discord</span>
                            <span class="routeNote bodyTextSmall">Ask the community and us, together</span>
                        </a>
                    </li>
                    <li>
                        <a href="/contact">
                            <span class="routeName subtitleSemi">Contact form</span>
                            <span class="routeNote bodyTextSmall">Asks the right follow-up questions for you</span>
                        </a>
                    </li>
                    <li>
                        <a href={`mailto:${SUPPORT_EMAIL}`}>
                            <span class="routeName subtitleSemi">{SUPPORT_EMAIL}</span>
                            <span class="routeNote bodyTextSmall">Plain email, if you'd rather</span>
                        </a>
                    </li>
                </ul>
            </section>
        </main>

        <Newsletter />
        <Footer />

        <script>
            import { initFaqFilter } from "../lib/faqFilter";
            initFaqFilter();
        </script>
    </body>
</html>

<style>
    /* A reference page, not a landing page: everything is open, nothing is
       behind a click, and Ctrl+F works on the whole document. The filter is
       an accelerator layered on top, never the only way to reach an answer. */

    .page {
        /* The site Header is `position: sticky; top: 0` — 94px at desktop
           widths, taller once its nav wraps — so anchor targets have to clear
           it. This is the pre-hydration fallback; faqFilter.ts corrects it. */
        --header-h: 5.875rem;

        width: min(100% - 2rem, 96rem); /* 1536px */
        margin-inline: auto;
        padding: 3.5rem var(--padding-sm) 5rem;
        box-sizing: border-box;

        color: var(--text-colour-light);
    }

    .srOnly {
        position: absolute;
        width: 1px; height: 1px;
        margin: -1px; padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* ── Masthead ─────────────────────────────────────────────────────── */

    .masthead {
        max-width: 44rem;
        padding-bottom: 3rem;
        margin-bottom: 3.5rem;
        border-bottom: 1px solid var(--hairline);
    }

    .eyebrow { color: var(--c-orange); margin: 0 0 0.75rem; letter-spacing: 0.06em; }
    .masthead h1 { margin: 0 0 1.25rem; text-wrap: balance; }
    .lead { margin: 0; color: var(--ink-body); line-height: 1.6; }

    /* ── Filter ───────────────────────────────────────────────────────── */

    .tools { margin-top: 2rem; }
    .tools[hidden] { display: none; }

    .searchWrap { position: relative; max-width: 26rem; }

    .search {
        width: 100%;
        height: 3rem;
        box-sizing: border-box;
        padding: 0 2.75rem 0 1rem;
        border: 1px solid var(--hairline);
        border-radius: var(--r-chip);
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-colour-light);
    }

    .search::placeholder { color: var(--ink-muted); }
    .search:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
    /* Safari draws its own clear affordance, which would sit under ours. */
    .search::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }

    .clear {
        position: absolute;
        top: 50%;
        right: 0.5rem;
        transform: translateY(-50%);
        width: 2rem; height: 2rem;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
    }

    .clear[hidden] { display: none; }
    .clear:hover { background: rgba(255, 255, 255, 0.08); }
    .clear:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    /* Drawn rather than iconified: two rules is less weight than a request,
       and it inherits the text colour without a mask. */
    .clear::before,
    .clear::after {
        content: "";
        position: absolute;
        width: 0.75rem;
        height: 1px;
        background: var(--ink-body);
    }

    .clear::before { transform: rotate(45deg); }
    .clear::after  { transform: rotate(-45deg); }

    .count { margin: 0.75rem 0 0; color: var(--ink-muted); min-height: 1.25em; }

    /* ── Section chips ────────────────────────────────────────────────── */

    .chips { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: 1.75rem; }

    .chips a {
        padding: 0.4375rem 0.9375rem;
        border: 1px solid var(--hairline);
        border-radius: var(--r-chip);
        color: var(--ink-body);
        text-decoration: none;
        transition: color 0.2s, border-color 0.2s, background 0.2s;
    }

    .chips a:hover {
        border-color: var(--c-orange);
        color: var(--c-orange);
        background: rgba(235, 164, 57, 0.08);
    }

    .chips a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    /* ── Groups ───────────────────────────────────────────────────────── */

    .doc { display: grid; gap: 4rem; }

    .group {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 3rem;
        align-items: start;

        scroll-margin-top: calc(var(--header-h) + 1.5rem);
    }

    .group[hidden] { display: none; }

    .groupHead { position: sticky; top: calc(var(--header-h) + 2rem); }
    .groupHead h2 { margin: 0 0 0.75rem; text-wrap: balance; }
    .groupBlurb { margin: 0; color: var(--ink-muted); line-height: 1.6; }

    .items { display: grid; gap: 1.5rem; }

    /* ── One question ─────────────────────────────────────────────────── */

    .qa {
        padding: 1.5rem 1.75rem;
        border-radius: var(--r-card);
        background: var(--surface-card);
        box-shadow: var(--surface-card-inset);

        scroll-margin-top: calc(var(--header-h) + 1.5rem);
    }

    .qa[hidden] { display: none; }

    /* Linking a heading to its own anchor is how people quote an answer at
       each other. The colour change is on the whole card so the target of a
       deep link is obvious on arrival. */
    .qa:target { outline: 1px solid var(--c-orange); }

    .qaQ { margin: 0 0 0.875rem; text-wrap: balance; }

    .qaAnchor {
        color: var(--text-colour-light);
        text-decoration: none;
    }

    .qaAnchor:hover { color: var(--c-orange); }
    .qaAnchor:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    .qaA p { margin: 0 0 0.875rem; color: var(--ink-body); line-height: 1.7; }
    .qaA p:last-child { margin-bottom: 0; }

    .qaLinks {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-top: 1.25rem !important;
    }

    .qaLinks a { color: var(--c-orange); text-decoration: none; }
    .qaLinks a:hover { color: var(--c-purple); text-decoration: underline; }
    .qaLinks a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    /* ── Nothing matched ──────────────────────────────────────────────── */

    .empty {
        padding: 2.5rem;
        border: 1px dashed var(--hairline);
        border-radius: var(--r-card);
        text-align: center;
    }

    .empty[hidden] { display: none; }
    .empty h2 { margin: 0 0 0.75rem; }
    .empty p { margin: 0 auto 1.75rem; color: var(--ink-body); max-width: 34rem; line-height: 1.7; }
    .empty a { text-decoration: none; box-sizing: border-box; }
    .term { color: var(--c-orange); }
    .term::before { content: "\201C"; }
    .term::after  { content: "\201D"; }

    /* ── Closing ──────────────────────────────────────────────────────── */

    .closing {
        margin-top: 4.5rem;
        padding-top: 3rem;
        border-top: 1px solid var(--hairline);

        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 3rem;
        align-items: start;
    }

    .closingCopy h2 { margin: 0 0 0.75rem; }
    .closingCopy p { margin: 0; color: var(--ink-muted); line-height: 1.6; }

    .routes { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.875rem; }

    .routes a {
        display: grid;
        gap: 0.25rem;
        padding: 1.125rem 1.375rem;
        border-radius: var(--r-card);
        background: var(--surface-card);
        box-shadow: var(--surface-card-inset);
        text-decoration: none;
        transition: box-shadow 0.2s;
    }

    .routes a:hover { box-shadow: var(--surface-card-inset), 0 0 0 1px var(--c-orange); }
    .routes a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
    .routeName { color: var(--text-colour-light); }
    .routeNote { color: var(--ink-muted); }

    /* ── Narrow ───────────────────────────────────────────────────────── */

    @media (max-width: 60rem) {
        .page { padding-inline: 2rem; }

        /* The sticky rail is the first thing to go: at this width it would
           occupy most of the screen before a single answer appeared. */
        .group,
        .closing {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.5rem;
        }

        .groupHead { position: static; }
    }

    @media (max-width: 40rem) {
        .page { padding-inline: 1.25rem; }
        .qa { padding: 1.25rem 1.25rem; }
        .empty { padding: 2rem 1.25rem; }
    }
</style>
