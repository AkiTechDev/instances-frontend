<style define:vars={{iconExpandedUrl, iconClosedUrl}}>
  .faqContainer {
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;

    padding: 7.5rem 10rem 6.25rem;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 3rem;

    justify-content: space-between;

    z-index: 2;
  }

  .faqHeaderContainer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    
    z-index: inherit;
  }

  .commonQuestionsContainer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;

    max-width: 60%;

    z-index: inherit;
  }

  .faqCard {
    display: flex;
    position: relative;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1.25rem;

    background: rgba(239, 241, 255, 0.05);
    border-radius: 8px;
    color: #ffffff;

    z-index: 0;
  }

  .faqCardBackground {
