    /* ── §2 definitions ──────────────────────────────────────────────────── */

    .defGrid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
        padding: 0;
    }

    .defCard {
        padding: 1.25rem;
        border-radius: var(--r-card);
        background: var(--surface);
        box-shadow: var(--surface-inset);
    }

    .defCard .defTerm { margin: 0 0 0.5rem; color: var(--c-orange); }
    .defCard dd { margin: 0; }

    /* ── §7 prohibited uses ──────────────────────────────────────────────── */

    /* The mirror of the tick list in styles/legal.css: same shape, opposite
       meaning, so a reader skimming both pages reads the marker before the text. */
    .banList { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 0.75rem; }

    .banList li { position: relative; padding-left: 2rem; }

    .banList li::before {
        content: "";
        position: absolute;
        top: 0.3125rem;
        left: 0;
        width: 1.125rem;
        height: 1.125rem;
        background-color: var(--c-red);
        -webkit-mask: url("../assets/icons/cross.svg") no-repeat center / contain;
        mask: url("../assets/icons/cross.svg") no-repeat center / contain;
    }

    /* ── A3 numbered obligations ─────────────────────────────────────────── */

    .numberedList { margin: 0 0 1rem; padding-left: 1.5rem; display: grid; gap: 0.625rem; }
    .numberedList li::marker { color: var(--c-orange); font-weight: 600; }

    /* ── Annex A divider ─────────────────────────────────────────────────── */

    .annexIntro {
        margin-top: 4.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid var(--hairline);
    }

    /* The id lives on the h2 (the scrollspy tracks h2[id]), so jumping to the
       annex would otherwise tuck the kicker and divider under the header. */
    .annexIntro h2 { scroll-margin-top: calc(var(--header-h) + 4.5rem); }
    .annexIntro .annexKicker { margin: 0 0 0.5rem; color: var(--c-purple); }
    .annexIntro h2 { margin-bottom: 1rem; }

    /* ── Contents: Annex group label ─────────────────────────────────────── */

    .tocGroup {
        display: block;
        margin: 1.25rem 0 0.625rem;
        padding: 0 0.625rem;
        color: var(--c-purple);
        text-decoration: none;
    }

    .tocGroup:hover { color: var(--c-orange); }

    .tocGroup:focus-visible {
        outline: var(--focus-ring);
        outline-offset: var(--focus-ring-offset);
        border-radius: 4px;
    }

    /* A2 is a row-header table: the label column carries the same weight the
       column headers do elsewhere. */
    .dataTable th[scope="row"] {
        width: 14rem;
        vertical-align: top;
        white-space: normal;
        background: none;
        border-bottom: 1px solid var(--hairline-soft);
    }

    @media screen and (max-width: 760px) {
        /* Stacked rows: the row header becomes the card's own label, and the
