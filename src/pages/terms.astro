        /* Match the stacked cells' zero side padding, or the label sits
           indented from the value beneath it. */
        .dataTable th[scope="row"] { display: block; width: auto; border-bottom: none; padding: 0.6875rem 0 0; }
        .dataTable th[scope="row"] + td::before { content: none; }
    }

    @media print {
