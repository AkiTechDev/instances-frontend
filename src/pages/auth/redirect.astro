---
// Landing point for the Zitadel authorization-code redirect. The page exchanges
// the code for tokens (PKCE verifier comes from sessionStorage) and then
// forwards the user to wherever they were originally heading.
Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Signing you in...</title>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />
    </head>
    <body>
        <script>
            import { handleRedirectCallback } from "../../lib/auth";
            handleRedirectCallback();
        </script>
    </body>
</html>
