---
// Order matters: tokens (theme/default) before the sheets that consume them,
// and identical on every entry point so the cascade can't diverge per page.
import Fonts from "../../components/Fonts.astro";

import "../../styles/normalise.css"
import "../../styles/global.css"
import "../../styles/theme/default.css"
import "../../styles/typography.css"

import type { GetStaticPaths } from "astro";
import { Picture } from "astro:assets";

import button from "../../styles/components/button.module.css";
import colourStyles from "../../styles/theme/colours.module.css";

import Header from "../../components/astrojs/header/Header.astro";
import Newsletter from "../../components/newsletter/Newsletter.astro";
import Footer from "../../components/astrojs/Footer/Footer.astro";

import { gameRegistry } from "../../lib/games";
import { draftSlugs } from "../../lib/games/draftSlugs";
import type { Game } from "../../lib/games/types";
import {
    PRICE_REGION_NAME,
    cheapestHourly,
    configRows,
    numberWord,
    tierViews,
    warnOnConfigDrift,
    warnOnTierDrift,
} from "../../lib/games/gamePage";

/* Banners are looked up rather than imported by name so this page stays a
   template: Vite needs a static path, and a glob gives it one for every game
   at once. */
const banners = import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/games/*/banner.png",
    { eager: true },
);

/**
 * A route exists only for games whose module carries a `page`. Today that's
 * Valheim alone — adding the next one is a content commit in
 * `lib/games/supported/<Game>.ts`, with nothing to change here.
 */
export const getStaticPaths = (async () => {
    const loaded = await Promise.all(
        Object.entries(gameRegistry).map(async ([id, entry]) => ({
            id,
            game: (await entry.load()).default,
        })),
    );

    return loaded
        .filter(({ game }) => game.page)
        .map(({ id, game }) => ({ params: { slug: game.page!.slug }, props: { id, game } }));
}) satisfies GetStaticPaths;

const { id, game } = Astro.props as { id: string; game: Game };
const page = game.page!;

const schema = await game.getSchema();
const schemaKeys = Object.keys(schema.entries);

/* Deliberately not gated behind import.meta.env.DEV: this runs at build time,
   never in the browser, so gating it would only hide the warning from CI —
   the one place it most needs to be seen. */
warnOnConfigDrift(id, schemaKeys, page.config);
warnOnTierDrift(id, game);

/* The sitemap filter reads draftSlugs; the page reads page.draft. If those
   disagree a page is either noindex and submitted, or indexable and hidden. */
if (Boolean(page.draft) !== draftSlugs.includes(page.slug)) {
    console.warn(
        `[games/${id}] draft status disagrees with lib/games/draftSlugs.ts.`,
        { pageDraft: Boolean(page.draft), inDraftSlugs: draftSlugs.includes(page.slug) },
    );
}

const settings = configRows(game, schema.entries as Record<string, unknown>);
const tiers = tierViews(game);
const cheapest = cheapestHourly(game);

const icon = gameRegistry[id]?.icon;
const banner = banners[`../../assets/games/${id}/banner.png`]?.default;

const domain = "instances.aki-labs.com";
const url = `https://${domain}/games/${page.slug}`;
const title = `${game.name} server hosting | Instances`;
const seo_des = page.summary;

const faqs = page.faqs ?? [];

/* FAQPage structured data. Only the questions actually on the page — marking
   up answers a reader can't see is what gets a site's rich results pulled —
   and only when there are any, since an empty FAQPage is a broken one. */
const faqLd = faqs.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((faq) => ({
            "@type": "Question",
            name: faq.q,
            acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
    }
    : null;

/* Draft pages stay out of the index until the words are signed off. `follow`
   rather than `none` so the links off them still carry. */
const robots = page.draft ? "noindex, follow" : "all";
---
<!doctype html>
<html lang="en" class="en" prefix="og: http://ogp.me/ns#">
    <head>
        <meta charset="UTF-8" />

        <Fonts />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="author" content="Aki Laboratories Limited">
        <meta name="referrer" content="strict-origin-when-cross-origin">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO -->
        <title>{title}</title>
        <meta name="description" content={seo_des}>
        <meta itemprop="description" content={seo_des}>
        <meta name="robots" content={robots} />
        <link rel="canonical" href={url}>
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Twitter/X specific -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={seo_des}>
        {banner && <meta name="twitter:image" content={banner.src}>}
        <meta name="twitter:site" content="@aki_labs">

        <!-- Open Graph -->
        <meta property="og:title" content={title}>
        <meta property="og:description" content={seo_des}>
        <meta property="og:type" content="website">
        <meta property="og:url" content={url}>
        {banner && <meta property="og:image" content={banner.src}>}
        <meta property="og:site_name" content="Instances">
        <meta property="og:locale" content="en_US">

        <!-- Mobile / Browser theming -->
        <meta name="theme-color" content="#191C2E">
        <meta name="apple-mobile-web-app-capable" content="yes">

        {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />}
    </head>
    <body>
        <Header />

        <main class="page">
            {import.meta.env.DEV && (
                <aside class="devChecklist" aria-label="Pre-publication checklist">
                    <p class="bodyTextSmallestSemiCaps">Dev only — not in the production build</p>
                    <ul>
                        <li>
                            Linked from <code>/games</code>, and from Games in the header and
                            footer. Draft pages are <code>noindex</code> and kept out of the
                            sitemap &mdash; see <code>lib/games/draftSlugs.ts</code>.
                        </li>
                        <li>
                            Prices are quoted for <strong>{PRICE_REGION_NAME}</strong> on the Default
                            tier, from <code>lib/pricing.ts</code>. Confirm that table is current
                            before this goes live.
                        </li>
                        <li>
                            One game has copy so far. Write <code>page</code> in another
                            <code>lib/games/supported/*.ts</code> and its route appears on the next build.
                        </li>
                    </ul>
                </aside>
            )}

            {page.draft && (
                <p class="draftNotice bodyTextSmall">
                    <strong>Draft.</strong> The sizes, prices and settings below are generated from
                    this game's own configuration and are accurate. The wording around them is
                    still being reviewed, so this page isn't listed in search yet.
                </p>
            )}

            <!-- ── Hero ─────────────────────────────────────────────────── -->
            <section class="hero" aria-labelledby="game-title">
                <div class="heroCopy">
                    <p class="eyebrow bodyTextSmallestSemiCaps">
                        <a href="/#games">All games</a> &nbsp;/&nbsp; {game.category}
                    </p>

                    <h1 id="game-title" class="h2">
                        {game.name} <span class={colourStyles.gradientOne}>server hosting</span>
                    </h1>

                    <p class="tagline subTitle">{page.tagline}</p>

                    <div class="heroActions">
                        <a href="/dashboard" class:list={[button.btn, button.vibrant]}>
                            <span class="buttonText">Start a {game.name} server</span>
                        </a>
                        {cheapest && (
                            <p class="fromPrice bodyTextSmall">
                                From <strong>${cheapest}</strong> an hour, billed only while it runs.
                            </p>
                        )}
                    </div>
                </div>

                {banner && (
                    <div class="heroMedia">
                        <Picture
                            src={banner}
                            formats={["avif", "webp"]}
                            width={880}
                            alt={`${game.name} key art`}
                            class="heroBanner"
                        />
                        {icon && (
                            <span
                                class="heroIcon"
                                aria-hidden="true"
                                style={`--icon: url("${icon.src}")`}
                            ></span>
                        )}
                    </div>
                )}
            </section>

            <!-- ── Intro ────────────────────────────────────────────────── -->
            <section class="intro" aria-labelledby="intro-title">
                <h2 id="intro-title" class="srOnly">About {game.name} on Instances</h2>
                {page.intro.map((paragraph) => <p class="introLead">{paragraph}</p>)}
            </section>

            <!-- ── Sizes ────────────────────────────────────────────────── -->
            <section class="sizes" aria-labelledby="sizes-title">
                <div class="sectionHead">
                    <h2 id="sizes-title" class="h5">{numberWord(tiers.length)} sizes, and why</h2>
                    <p class="sectionLead bodyText">
                        Prices are for {PRICE_REGION_NAME}; other regions differ by up to a quarter.
                        You can change size later without starting a new world.
                    </p>
                </div>

                <ul class="tiers">
                    {tiers.map((tier) => (
                        <li class="tier">
                            <h3 class="tierName subtitleSemi">{tier.id}</h3>
                            <p class="tierPrice h6">
                                {tier.hourly ? <>${tier.hourly}<span class="per">/hour</span></> : <span class="per">Price unavailable</span>}
                            </p>
                            <dl class="tierSpecs">
                                <div>
                                    <dt class="bodyTextSmallestSemiCaps">vCPU</dt>
                                    <dd class="statsText">{tier.vcpu}</dd>
                                </div>
                                <div>
                                    <dt class="bodyTextSmallestSemiCaps">Memory</dt>
                                    <dd class="statsText">{tier.memoryGb} GB</dd>
                                </div>
                            </dl>
                            {tier.note && <p class="tierNote bodyTextSmall">{tier.note}</p>}
                        </li>
                    ))}
                </ul>
            </section>

            <!-- ── Sizing rationale ─────────────────────────────────────── -->
            <section class="rationale" aria-labelledby="rationale-title">
                <div class="sectionHead">
                    <h2 id="rationale-title" class="h5">How we picked them</h2>
                </div>
                <ul class="reasons">
                    {page.sizing.map((reason) => <li class="reason bodyText">{reason}</li>)}
                </ul>
            </section>

            <!-- ── Configurable settings ────────────────────────────────── -->
            <section class="settings" aria-labelledby="settings-title">
                <div class="sectionHead">
                    <h2 id="settings-title" class="h5">What you can change</h2>
                    <p class="sectionLead bodyText">
                        Set from the instance's configuration page. The limits below are the ones
                        the server actually enforces &mdash; they're read from its own schema.
                        {!page.config?.length && " Plain-English descriptions are still being written."}
                    </p>
                </div>

                <div class="tableScroll" role="region" aria-labelledby="settings-title" tabindex="0">
                    <table class="settingsTable">
                        <colgroup>
                            <col class="colSetting" />
                            <col class="colDesc" />
                            <col class="colAccepts" />
                        </colgroup>
                        <caption class="srOnly">
                            {game.name} server settings, what each one does, and its accepted values
                        </caption>
                        <thead>
                            <tr>
                                <th scope="col" class="bodyTextSmallestSemiCaps">Setting</th>
                                <th scope="col" class="bodyTextSmallestSemiCaps">What it does</th>
                                <th scope="col" class="bodyTextSmallestSemiCaps">Accepts</th>
                            </tr>
                        </thead>
                        <tbody>
                            {settings.map((field) => (
                                <tr>
                                    <th scope="row" class="bodyTextSmallSemi">{field.label}</th>
                                    <td class="bodyTextSmall">{field.description}</td>
                                    <td class="bodyTextSmall constraint">{field.constraint}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- ── FAQ ──────────────────────────────────────────────────── -->
            {faqs.length > 0 && (
            <section class="faq" aria-labelledby="faq-title">
                <div class="sectionHead">
                    <h2 id="faq-title" class="h5">Questions people actually ask</h2>
                </div>
                <dl class="faqList">
                    {faqs.map((faq) => (
                        <div class="faqItem">
                            <dt class="faqQ subtitleSemi">{faq.q}</dt>
                            <dd class="faqA bodyText">{faq.a}</dd>
                        </div>
                    ))}
                </dl>
            </section>
            )}

            <!-- ── Closing ──────────────────────────────────────────────── -->
            <section class="closing" aria-labelledby="closing-title">
                <h2 id="closing-title" class="h6">Ready when you are</h2>
                <p class="bodyText closingLead">
                    Pick a size, name your world, and it's running in a couple of minutes. Stop it
                    when you're done and the billing stops with it.
                </p>
                <div class="closingActions">
                    <a href="/dashboard" class:list={[button.btn, button.vibrant]}>
                        <span class="buttonText">Start a {game.name} server</span>
                    </a>
                    <a href="/contact?topic=question" class:list={[button.btn, button.outline]}>
                        <span class="buttonText">Ask us first</span>
                    </a>
                </div>
            </section>
        </main>

        <Newsletter />
        <Footer />
    </body>
</html>

<style>
    /* Scoped to this route. It is a template for every game page, so nothing
       here may assume Valheim specifically — the only game-shaped inputs are
       the banner's aspect ratio and the number of tiers, both handled by the
       layout rather than by fixed sizes. */

    .page {
        /* The site Header is `position: sticky; top: 0`, so anchor targets and
           anything else that sticks has to clear it. No runtime sync is needed
           here: this page has no in-page anchors and nothing sticky of its own,
           so the token exists only for section scroll-margin. */
        --header-h: 5.875rem;

        width: min(100% - 2rem, 96rem); /* 1536px */
        margin-inline: auto;
        padding: 3.5rem var(--padding-sm) 5rem;
        box-sizing: border-box;

        color: var(--text-colour-light);
    }

    .srOnly {
        position: absolute;
        width: 1px; height: 1px;
        margin: -1px; padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* ── Dev-only pre-publication checklist ───────────────────────────── */

    .devChecklist {
        margin-bottom: 3rem;
        padding: 1.25rem 1.5rem;
        border: 1px dashed var(--c-orange);
        border-radius: var(--r-card);
        background: rgba(235, 164, 57, 0.08);
    }

    .devChecklist > p { color: var(--c-orange); margin: 0 0 0.75rem; }
    .devChecklist ul { margin: 0; padding-left: 1.25rem; display: grid; gap: 0.375rem; }
    .devChecklist li { color: var(--ink-body); line-height: 1.6; }
    .devChecklist li::marker { color: var(--c-orange); }
    .devChecklist code {
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.9em;
    }

    /* ── Draft notice ─────────────────────────────────────────────────── */

    /* Deliberately visible rather than dev-only: anyone holding the link should
       know the prose hasn't been signed off. Quiet enough not to wreck the page,
       loud enough that it can't ship unnoticed. */
    .draftNotice {
        margin: 0 0 2.5rem;
        padding: 0.875rem 1.125rem;
        border-left: 3px solid var(--c-orange);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
        background: rgba(235, 164, 57, 0.09);
        color: var(--ink-body);
        line-height: 1.6;
    }

    .draftNotice strong { color: var(--c-orange); }

    /* ── Hero ─────────────────────────────────────────────────────────── */

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        gap: 4rem;
        align-items: center;

        padding-bottom: 4rem;
        border-bottom: 1px solid var(--hairline);
        margin-bottom: 4rem;
    }

    .eyebrow { color: var(--ink-muted); margin: 0 0 1rem; letter-spacing: 0.06em; }
    .eyebrow a { color: var(--c-orange); text-decoration: none; }
    .eyebrow a:hover { color: var(--c-purple); }
    .eyebrow a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    .heroCopy h1 { margin: 0 0 1.25rem; text-wrap: balance; }
    .tagline { margin: 0 0 2rem; color: var(--ink-body); max-width: 32rem; }

    .heroActions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.75rem; }
    .heroActions a { text-decoration: none; box-sizing: border-box; }
    .fromPrice { margin: 0; color: var(--ink-muted); }
    .fromPrice strong { color: var(--text-colour-light); font-variant-numeric: tabular-nums; }

    .heroMedia { position: relative; }

    .heroBanner {
        width: 100%;
        height: auto;
        border-radius: var(--r-card);
        box-shadow: var(--surface-card-inset), 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    /* The icon overlaps the banner's corner so the game is identifiable even
       when the key art is a wide scene with no title in it.

       The registry's game marks are solid #191C2E — the same ink as the chip
       behind them — so the glyph is masked and painted rather than drawn. The
       url() has to be an inline custom property because it varies per game;
       it is double-quoted so it survives even if Vite inlines a small mark as
       a data URI (whose own single quotes would otherwise void the rule). */
    .heroIcon {
        position: absolute;
        left: -1.25rem;
        bottom: -1.25rem;
        width: 4.5rem;
        height: 4.5rem;
        border-radius: var(--r-card);
        background: var(--c-ink);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);

        display: grid;
        place-items: center;
    }

    .heroIcon::before {
        content: "";
        width: 62%;
        height: 62%;
        background-color: var(--text-colour-light);
        -webkit-mask: var(--icon) no-repeat center / contain;
        mask: var(--icon) no-repeat center / contain;
    }

    /* ── Shared section furniture ─────────────────────────────────────── */

    .page section { scroll-margin-top: calc(var(--header-h) + 1rem); }

    .sectionHead { max-width: 44rem; margin-bottom: 2rem; }
    .sectionHead h2 { margin: 0 0 0.875rem; text-wrap: balance; }
    .sectionLead { margin: 0; color: var(--ink-body); line-height: 1.7; }

    .intro { max-width: 50rem; margin-bottom: 4.5rem; }
    .introLead { margin: 0 0 1.25rem; color: var(--ink-body); line-height: 1.75; font-size: 1.125rem; }
    .introLead:last-child { margin-bottom: 0; }

    .sizes, .rationale, .settings, .faq { margin-bottom: 4.5rem; }

    /* ── Tiers ────────────────────────────────────────────────────────── */

    .tiers {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        /* auto-fit would leave a dead column when a game defines two tiers;
           the count comes from the game, so let the tracks wrap by width. */
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
        gap: 1.25rem;
    }

    .tier {
        display: grid;
        align-content: start;
        gap: 0.75rem;

        padding: 1.75rem;
        border-radius: var(--r-card);
        background: var(--surface-card);
        box-shadow: var(--surface-card-inset);
    }

    .tierName { margin: 0; color: var(--text-colour-light); }

    .tierPrice {
        margin: 0;
        color: var(--c-orange);
        font-variant-numeric: tabular-nums;
    }

    .per { color: var(--ink-muted); font-size: 1rem; font-weight: 400; }

    .tierSpecs {
        display: flex;
        gap: 2rem;
        margin: 0.25rem 0 0;
        padding: 0.875rem 0 0;
        border-top: 1px solid var(--hairline-soft);
    }

    .tierSpecs dt { color: var(--ink-muted); letter-spacing: 0.06em; margin-bottom: 0.25rem; }
    .tierSpecs dd { margin: 0; color: var(--text-colour-light); font-variant-numeric: tabular-nums; }

    .tierNote { margin: 0.25rem 0 0; color: var(--ink-body); line-height: 1.6; }

    /* ── Rationale ────────────────────────────────────────────────────── */

    /* Not numbered: these are four independent reasons, not four steps. */
    .reasons { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; max-width: 54rem; }

    .reason {
        margin: 0;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--c-purple);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
        background: rgba(197, 137, 244, 0.08);
        color: var(--ink-body);
        line-height: 1.7;
    }

    /* ── Settings table ───────────────────────────────────────────────── */

    /* The table gets its own scroll container so a narrow screen never makes
       the whole page scroll sideways. */
    .tableScroll { overflow-x: auto; }
    .tableScroll:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

    .settingsTable {
        width: 100%;
        max-width: 68rem;   /* full-bleed at 1440 leaves the columns marooned */
        border-collapse: collapse;
        min-width: 34rem;
        text-align: left;
    }

    /* The description absorbs the slack so "Accepts" sits next to the text it
       qualifies rather than against the far edge. */
    .colDesc { width: 100%; }
    .colSetting, .colAccepts { width: 1%; }

    .settingsTable th,
    .settingsTable td {
        padding: 0.875rem 1.125rem 0.875rem 0;
        border-bottom: 1px solid var(--hairline-soft);
        vertical-align: top;
    }

    .settingsTable thead th {
        color: var(--c-orange);
        letter-spacing: 0.06em;
        border-bottom-color: var(--hairline);
        padding-bottom: 0.625rem;
    }

    .settingsTable tbody th { color: var(--text-colour-light); white-space: nowrap; }
    .settingsTable td { color: var(--ink-body); line-height: 1.6; }

    .constraint {
        color: var(--ink-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    /* ── FAQ ──────────────────────────────────────────────────────────── */

    .faqList { margin: 0; display: grid; gap: 1.5rem; max-width: 54rem; }
    .faqItem { padding-bottom: 1.5rem; border-bottom: 1px solid var(--hairline-soft); }
    .faqItem:last-child { padding-bottom: 0; border-bottom: 0; }
    .faqQ { margin: 0 0 0.625rem; color: var(--text-colour-light); }
    .faqA { margin: 0; color: var(--ink-body); line-height: 1.75; }

    /* ── Closing ──────────────────────────────────────────────────────── */

    .closing {
        padding-top: 3rem;
        border-top: 1px solid var(--hairline);
    }

    .closing h2 { margin: 0 0 1rem; font-size: 1.375rem; line-height: 1.3; }
    .closingLead { margin: 0 0 2rem; color: var(--ink-body); line-height: 1.7; max-width: 40rem; }
    .closingActions { display: flex; flex-wrap: wrap; gap: 1rem; }
    .closingActions a { text-decoration: none; box-sizing: border-box; }

    /* ── Responsive ───────────────────────────────────────────────────── */

    @media (max-width: 1100px) {
        .page { padding-left: var(--space-md); padding-right: var(--space-md); }
        .hero { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
        /* The icon's negative offset would hang off the page edge once the
           banner is full width. */
        .heroIcon { left: 1rem; bottom: 1rem; }
    }

    @media (max-width: 760px) {
        .page { padding: 2.5rem 1.25rem 3.5rem; }
        .introLead { font-size: 1rem; }
        /* box-sizing is set on the base rule: .btn is padded but content-box,
           so a full-width anchor would otherwise overflow by its own padding. */
        .heroActions a, .closingActions a { width: 100%; }
        .heroActions { flex-direction: column; align-items: stretch; }
        .closingActions { flex-direction: column; align-items: stretch; }
    }
</style>
