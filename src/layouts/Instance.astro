<!-- Dashboard.astro -->
---
// Welcome to Astro! Everything between these triple-dash code fences
// is your "component frontmatter". It never runs in the browser.

import "../styles/normalise.css"
import "../styles/global.css"
import "../styles/theme/default.css"
import "../styles/variables.css"
import "../styles/typography.css"

import Newsletter from "../components/newsletter/Newsletter.astro";
import Footer from "../components/footer/Footer.astro";

import AppRouter from "../components/app/Router";
---
<!-- Below is your "component template." It's just HTML, but with
    some magic sprinkled in to help you build great templates. -->
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="author" content="Aki Laboratories Limited">
        <meta name="referrer" content="strict-origin-when-cross-origin">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <title>My Games - Instances</title>

        <!-- Claude said no because its behind a login, test manually once published to the domain
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="Instances - Game Servers Made Easy, Pay As You Play">
        <meta name="twitter:description" content={seo_des}>
        <meta name="twitter:image" content={`https://${domain}/og-image.jpg`}>
        <meta name="twitter:site" content="@aki_labs">


        Open Graph
        <meta property="og:title" content="Instances - Game Servers Made Easy, Pay As You Play">
        <meta property="og:description" content={seo_des}>
        <meta property="og:type" content="website">
        <meta property="og:url" content=`https://${domain}`>
        <meta property="og:image" content=`https://${domain}/og-image.jpg`>
        <meta property="og:site_name" content="Instances">
        <meta property="og:locale" content="en_US">
        -->

        <meta name="robots" content="none" />
        <link rel="canonical" href="https://instances.aki-labs.com">
        <link rel="sitemap" href="/sitemap-index.xml" />
	</head>
    <body class="grid-container">
        <AppRouter client:only />

        <div class="full">
            <Newsletter class="full"  />
        </div>

        <div class="full">
            <Footer />
        </div>
    </body>
</html>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: 100px 1fr;
        grid-template-rows: minmax(800px, auto);

    }

    .full {
        grid-column: 1 / -1;
    }

</style>

<script>
  import { getMsal } from "../lib/auth"
  
  const msalInstance = await getMsal();
  if (!msalInstance) throw new Error("MSAL not initialized");

  const result = await msalInstance.handleRedirectPromise();

  if (result) {
    msalInstance.setActiveAccount(result.account)
  } else {
    const accounts = msalInstance.getAllAccounts();

    if (accounts.length === 0) {
      window.location.href = "/";
    } else {
      msalInstance.setActiveAccount(accounts[0])
    }
  }
</script>