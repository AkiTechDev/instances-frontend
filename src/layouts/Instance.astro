<!-- Dashboard.astro -->
---
// Welcome to Astro! Everything between these triple-dash code fences
// is your "component frontmatter". It never runs in the browser.

import "../styles/normalise.css"
import "../styles/global.css"
import "../styles/theme/default.css"
import "../styles/variables.css"
import "../styles/typography.css"

import Newsletter from "../components/newsletter/Newsletter.astro";
import Footer from "../components/footer/Footer.astro";

import AppRouter from "../components/app/Router";
---
<!-- Below is your "component template." It's just HTML, but with
    some magic sprinkled in to help you build great templates. -->
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Qwik + Astro integration" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>Instances Dashboard</title>
	</head>
    <body class="grid-container">
        <AppRouter client:only />

        <div class="full">
            <Newsletter class="full"  />
        </div>

        <div class="full">
            <Footer />
        </div>
    </body>
</html>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: 100px 1fr;
        grid-template-rows: minmax(800px, auto);

    }

    .full {
        grid-column: 1 / -1;
    }

</style>

<script>
  import { getMsal } from "../lib/auth"
  
  const msalInstance = await getMsal();
  if (!msalInstance) throw new Error("MSAL not initialized");

  const result = await msalInstance.handleRedirectPromise();

  if (result) {
    msalInstance.setActiveAccount(result.account)
  } else {
    const accounts = msalInstance.getAllAccounts();

    if (accounts.length === 0) {
      window.location.href = "/";
    } else {
      msalInstance.setActiveAccount(accounts[0])
    }
  }
</script>